{
  "name": "accessible-react-form",
  "version": "0.0.1-alpha.1",
  "description": "An accessible, minimal React form library. Built on react-hook-form. Works with any Standard Schema validator (yup, zod, valibot, arktype).",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "npm run build-storybook && npm run test-storybook:ci",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-lib": "rollup -c",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build-lib"
  },
  "keywords": [
    "react",
    "form",
    "accessible",
    "accessibility",
    "a11y",
    "react-hook-form",
    "standard-schema",
    "yup",
    "zod",
    "valibot",
    "validation",
    "wcag"
  ],
  "author": {
    "name": "Saylor",
    "email": "hello@sallf.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sallf/accessible-react-form.git"
  },
  "homepage": "https://github.com/sallf/accessible-react-form#readme",
  "bugs": {
    "url": "https://github.com/sallf/accessible-react-form/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@testing-library/react": "^16.3.2",
    "@types/chai": "^4.3.20",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axe-playwright": "^2.2.2",
    "babel-loader": "^9.2.1",
    "chromatic": "^18.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "http-server": "^14.1.1",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup": "^4.60.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "sass": "^1.99.0",
    "storybook": "^10.3.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "valibot": "^1.3.1",
    "wait-on": "^9.1.0",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-hook-form": "^7.75.0"
  }
}
