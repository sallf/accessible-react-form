{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "accessible-react-form": ["./src/index.ts"]
    },
    "sourceMap": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["@testing-library/jest-dom", "chai"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "tmp", "dist", "site", "storybook-static"]
}
